{
 "proof": [
  {
   "text": "汝欲見如來，為以何等觀如來乎",
   "attrib": "維摩詰所說經",
   "cbeta": null,
   "line": 289
  },
  {
   "text": "如自觀身實相，觀佛亦然…前際不來後際不去今則不住",
   "attrib": "維摩詰所說經",
   "cbeta": null,
   "line": 289
  },
  {
   "text": "不觀色…非四大起，同於虛空",
   "attrib": "維摩詰所說經",
   "cbeta": null,
   "line": 289
  },
  {
   "text": "六入無積…順三脫門，具足三明，與無明等",
   "attrib": "維摩詰所說經",
   "cbeta": null,
   "line": 291
  },
  {
   "text": "不一相不異相…不中流而化眾生",
   "attrib": "維摩詰所說經",
   "cbeta": null,
   "line": 291
  },
  {
   "text": "觀自在菩薩行深般若…度一切苦厄",
   "attrib": "心經",
   "cbeta": null,
   "line": 137
  },
  {
   "text": "色不異空，空不異色，色即是空，空即是色",
   "attrib": "心經",
   "cbeta": null,
   "line": 137
  },
  {
   "text": "是諸法空相，不生不滅…無智亦無得",
   "attrib": "心經",
   "cbeta": null,
   "line": 364
  },
  {
   "text": "以無所得故…三世諸佛…阿耨多羅三藐三菩提",
   "attrib": "心經",
   "cbeta": null,
   "line": 366
  },
  {
   "text": "凡所有相皆是虛妄，若見諸相非相則見如來",
   "attrib": "金剛經",
   "cbeta": null,
   "line": 373
  },
  {
   "text": "可以三十二相見如來不…即是非相是名三十二相",
   "attrib": "金剛經",
   "cbeta": null,
   "line": 432
  },
  {
   "text": "過去心不可得，現在心不可得，未來心不可得",
   "attrib": "金剛經",
   "cbeta": null,
   "line": 468
  },
  {
   "text": "若菩薩通達無我法者，如來說名真是菩薩",
   "attrib": "金剛經",
   "cbeta": null,
   "line": 582
  },
  {
   "text": "一切有為法，如夢、幻、泡、影，如露亦如電，應作如是觀。",
   "attrib": "金剛經",
   "cbeta": null,
   "line": 777
  },
  {
   "text": "諸佛如來是法界身，遍入一切眾生心想中；是故汝等心想佛時，是心即是三十二相、八十隨形好。是心作佛，是心是佛。",
   "attrib": "觀無量壽佛經",
   "cbeta": null,
   "line": 50
  },
  {
   "text": "如染香人，身有香氣，此則名曰香光莊嚴。",
   "attrib": "楞嚴經(大勢至菩薩念佛圓通章)",
   "cbeta": null,
   "line": 176
  },
  {
   "text": "有覺覺痛（畢陵伽婆蹉，卷五）",
   "attrib": "楞嚴經",
   "cbeta": null,
   "line": 747
  },
  {
   "text": "一性圓通一切性…諸佛法身入我性…剎那滅却三祇劫",
   "attrib": "永嘉證道歌",
   "cbeta": null,
   "line": 614
  },
  {
   "text": "君不見絕學無為閑道人，不除妄想不求真",
   "attrib": "永嘉證道歌",
   "cbeta": null,
   "line": 161
  },
  {
   "text": "臥輪有伎倆，能斷百思想，對境心不起，菩提日日長。",
   "attrib": "六祖壇經(機緣品錄臥輪偈)",
   "cbeta": null,
   "line": 628
  },
  {
   "text": "心地無非自性戒…不增不減自金剛，身去身來本三昧",
   "attrib": "六祖壇經",
   "cbeta": null,
   "line": 698
  },
  {
   "text": "假借四大以為身，心本無生因境有…罪福如幻起亦滅",
   "attrib": "毘舍浮佛偈",
   "cbeta": null,
   "line": 588
  },
  {
   "text": "一切諸法同一義，以修空故如實知，彼無種種別異相，於此一義已修學",
   "attrib": "月燈三昧經",
   "cbeta": null,
   "line": 222
  },
  {
   "text": "文殊殺佛偈(canon) 文殊大智慧…二事同一相…",
   "attrib": "如幻三昧經",
   "cbeta": null,
   "line": 550
  },
  {
   "text": "菩薩清涼月，常遊畢竟空，眾生心垢淨，菩提影現中",
   "attrib": "華嚴系偈頌",
   "cbeta": null,
   "line": 448
  }
 ],
