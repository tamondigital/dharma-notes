{
 "proof": [
  {
   "text": "如來善護念諸菩薩善付囑諸菩薩",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": 83
  },
  {
   "text": "如是滅度無量無數無邊眾生實無眾生得滅度者",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": 95
  },
  {
   "text": "若菩薩有我相人相眾生相壽者相即非菩薩",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": 103
  },
  {
   "text": "菩薩無住相布施福德亦復如是不可思量菩薩但應如所教住",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": 111
  },
  {
   "text": "凡所有相皆是虛妄若見諸相非相則見如來",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": 119
  },
  {
   "text": "一切有為法如夢幻泡影如露亦如電應作如是觀",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": 123
  },
  {
   "text": "如來滅後後五百歲有持戒修福者於此章句能生信心",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": 161
  },
  {
   "text": "已於無量千萬佛所種諸善根",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": 161
  },
  {
   "text": "是諸眾生若心取相則為著我人眾生壽者",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": 187
  },
  {
   "text": "若取非法相即著我人眾生壽者",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": 187
  },
  {
   "text": "知我說法如筏喻者法尚應捨何況非法",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": 652
  },
  {
   "text": "無有定法名阿耨多羅三藐三菩提亦無有定法如來可說",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": 234
  },
  {
   "text": "如來所說法皆不可取不可說非法非非法",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": 234
  },
  {
   "text": "一切賢聖皆以無為法而有差別",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": 234
  },
  {
   "text": "若人滿三千大千世界七寶以用布施是人所得福德寧為多不",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": 445
  },
  {
   "text": "是福德即非福德性是故如來說福德多",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": 445
  },
  {
   "text": "一切諸佛及諸佛阿耨多羅三藐三菩提法皆從此經出",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": 447
  },
  {
   "text": "所謂佛法者即非佛法",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": 447
  },
  {
   "text": "說法者無法可說是名說法",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": 314
  },
  {
   "text": "莊嚴佛土者即非莊嚴是名莊嚴",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": 526
  },
  {
   "text": "應化非真佛亦非說法者說法不二取無說離言相",
   "attrib": "彌勒偈",
   "cbeta": "T1511",
   "line": 260
  },
  {
   "text": "不識本心學法無益",
   "attrib": "六祖壇經",
   "cbeta": "T2008",
   "line": 306
  },
  {
   "text": "以無所得故菩提薩埵依般若波羅蜜多故心無罣礙",
   "attrib": "心經",
   "cbeta": "T0251",
   "line": 566
  },
  {
   "text": "三世諸佛依般若波羅蜜多故得阿耨多羅三藐三菩提",
   "attrib": "心經",
   "cbeta": "T0251",
   "line": 568
  },
  {
   "text": "心如工畫師能畫諸世間",
   "attrib": "華嚴經",
   "cbeta": "T0279",
   "line": 203
  },
  {
   "text": "心佛及眾生是三無差別",
   "attrib": "華嚴經(眾生三無差別)",
   "cbeta": "T0278",
   "line": 402
  },
  {
   "text": "覺即了不施功一切有為法不同住相布施生天福猶如仰箭射虛空",
   "attrib": "永嘉證道歌",
   "cbeta": "T2014",
   "line": 391
  },
  {
   "text": "不見一法即如來方得名為觀自在",
   "attrib": "永嘉證道歌",
   "cbeta": "T2014",
   "line": 605
  },
  {
   "text": "了了見無一物亦無人亦無佛大千沙界海中漚一切聖賢如電拂",
   "attrib": "永嘉證道歌",
   "cbeta": "T2014",
   "line": 616
  },
  {
   "text": "心是根法是塵兩種猶如鏡上痕",
   "attrib": "永嘉證道歌",
   "cbeta": "T2014",
   "line": 191
  },
  {
   "text": "知幻即離不作方便離幻即覺亦無漸次",
   "attrib": "圓覺經",
   "cbeta": "T0842",
   "line": 588
  },
  {
   "text": "當知身心皆為幻垢垢相永滅十方清淨",
   "attrib": "圓覺經",
   "cbeta": "T0842",
   "line": 618
  },
  {
   "text": "始知眾生本來成佛",
   "attrib": "圓覺經",
   "cbeta": "T0842",
   "line": 630
  },
  {
   "text": "狂性自歇歇即菩提",
   "attrib": "楞嚴經",
   "cbeta": "T0945",
   "line": 412
  },
  {
   "text": "言語道斷心行處滅",
   "attrib": "-",
   "cbeta": "T0657",
   "line": 312
  },
  {
   "text": "心外無法法外無心心即是法法即是心",
   "attrib": "黃蘗傳心法要",
   "cbeta": "T2012A",
   "line": 193
  },
  {
   "text": "法施具足二莊嚴財施非因故非勝應知法施離取著取著不名為受持",
   "attrib": "金剛心論/文殊菩薩",
   "cbeta": "X0479",
   "line": 483
  },
  {
   "text": "佛性雖堅煩惱能亂煩惱雖堅般若智能破",
   "attrib": "六祖金剛經口訣",
   "cbeta": "X0459",
   "line": 125
  },
  {
   "text": "般若無知無所不知",
   "attrib": "黃蘗/般若",
   "cbeta": "T2013",
   "line": 331
  }
 ],
