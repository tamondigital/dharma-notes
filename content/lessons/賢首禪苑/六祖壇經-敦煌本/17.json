{
 "proof": [
  {
   "text": "今既發四弘誓願訖，與善知識授無相懺悔，滅三世罪障",
   "attrib": "《壇經》（敦煌本）",
   "cbeta": "T2007",
   "line": 408
  },
  {
   "text": "念念不被愚迷染。從前惡行一時除，自性若除即是懺",
   "attrib": "《壇經》（敦煌本）",
   "cbeta": "T2007",
   "line": 444
  },
  {
   "text": "念念不被疽疾染，除却從前嫉妒心，自性若除即是懺",
   "attrib": "《壇經》（敦煌本）",
   "cbeta": "T2007",
   "line": 424
  },
  {
   "text": "除却從前矯誑心，永斷名為自性懺",
   "attrib": "《壇經》（敦煌本）",
   "cbeta": "T2007",
   "line": 535
  },
  {
   "text": "懺者終身不作，悔者知於前非。惡業恆不離心，諸佛前口說無益，我此法門中，永斷不作，名為懺悔",
   "attrib": "《壇經》（敦煌本）",
   "cbeta": "T2007",
   "line": 414
  },
  {
   "text": "以智惠觀照，內外明澈，識自本心。若識本心，即是解脫",
   "attrib": "《壇經》（敦煌本）",
   "cbeta": "T2007",
   "line": 238
  },
  {
   "text": "外離相即禪，內不亂即定，外禪內定，故名禪定",
   "attrib": "《壇經》（敦煌本）",
   "cbeta": "T2007",
   "line": 232
  },
  {
   "text": "不識本心，學法無益",
   "attrib": "《壇經》（敦煌本）",
   "cbeta": "T2007",
   "line": 236
  },
  {
   "text": "無念為宗，無相為體，無住為本",
   "attrib": "《壇經》（敦煌本）",
   "cbeta": "T2007",
   "line": 177
  },
  {
   "text": "無住者，為人本性，念念不住，前念、今念、後念，念念相續",
   "attrib": "《壇經》（敦煌本）",
   "cbeta": "T2007",
   "line": 177
  },
  {
   "text": "何期自性，本自清淨",
   "attrib": "《壇經》（曹溪本）",
   "cbeta": "T2008",
   "line": 970
  },
  {
   "text": "譬如幻師，見所幻人，菩薩觀眾生為若此",
   "attrib": "《維摩詰所說經》",
   "cbeta": "T0475",
   "line": 634
  },
  {
   "text": "彼罪性不在內、不在外、不在中間",
   "attrib": "《維摩詰所說經》",
   "cbeta": "T0475",
   "line": 701
  },
  {
   "text": "能觀三界如影響故。猶如幻師觀於幻人無有障礙",
   "attrib": "《佛說淨業障經》",
   "cbeta": "T1494",
   "line": 634
  },
  {
   "text": "諸法同鏡像",
   "attrib": "《佛說淨業障經》",
   "cbeta": "T1494",
   "line": 695
  },
  {
   "text": "亦如水中月",
   "attrib": "《佛說淨業障經》",
   "cbeta": "T1494",
   "line": 695
  },
  {
   "text": "法無作無處",
   "attrib": "《佛說淨業障經》",
   "cbeta": "T1494",
   "line": 697
  },
  {
   "text": "如虛空清淨",
   "attrib": "《佛說淨業障經》",
   "cbeta": "T1494",
   "line": 697
  },
  {
   "text": "一切業障海",
   "attrib": "《佛說觀普賢菩薩行法經》",
   "cbeta": "T0277",
   "line": 848
  },
  {
   "text": "皆從妄想生",
   "attrib": "《佛說觀普賢菩薩行法經》",
   "cbeta": "T0277",
   "line": 848
  },
  {
   "text": "端坐念實相",
   "attrib": "《佛說觀普賢菩薩行法經》",
   "cbeta": "T0277",
   "line": 877
  },
  {
   "text": "眾罪如霜露",
   "attrib": "《佛說觀普賢菩薩行法經》",
   "cbeta": "T0277",
   "line": 926
  },
  {
   "text": "慧日能消除",
   "attrib": "《佛說觀普賢菩薩行法經》",
   "cbeta": "T0277",
   "line": 926
  },
  {
   "text": "一切唯心造",
   "attrib": "《大方廣佛華嚴經》",
   "cbeta": "T0279",
   "line": 799
  },
  {
   "text": "譬如工畫師",
   "attrib": "《大方廣佛華嚴經》",
   "cbeta": "T0279",
   "line": 658
  },
  {
   "text": "五蘊悉從生",
   "attrib": "《大方廣佛華嚴經》",
   "cbeta": "T0279",
   "line": 658
  },
  {
   "text": "無法而不造",
   "attrib": "《大方廣佛華嚴經》",
   "cbeta": "T0279",
   "line": 658
  },
  {
   "text": "雖復繁興鼓躍。未始動於心源",
   "attrib": "《大乘起信論義記》",
   "cbeta": "T1846",
   "line": 125
  },
  {
   "text": "靜謐虛凝。未嘗乖於業果",
   "attrib": "《大乘起信論義記》",
   "cbeta": "T1846",
   "line": 125
  },
  {
   "text": "從心現境妙有觀",
   "attrib": "《修華嚴奧旨妄盡還源觀》",
   "cbeta": "T1876",
   "line": 163
  },
  {
   "text": "攝境歸心真空觀",
   "attrib": "《修華嚴奧旨妄盡還源觀》",
   "cbeta": "T1876",
   "line": 166
  },
  {
   "text": "心境祕密圓融觀",
   "attrib": "《修華嚴奧旨妄盡還源觀》",
   "cbeta": "T1876",
   "line": 171
  },
  {
   "text": "在胎曰身。處世名人。在眼曰見",
   "attrib": "《宗鏡錄》引波羅提尊者偈",
   "cbeta": "T2016",
   "line": 320
  },
  {
   "text": "見性是佛",
   "attrib": "《宗鏡錄》引波羅提尊者問答",
   "cbeta": "T2016",
   "line": 303
  },
  {
   "text": "性在作用",
   "attrib": "《宗鏡錄》引波羅提尊者問答",
   "cbeta": "T2016",
   "line": 317
  },
  {
   "text": "假借四大以為身。心本無生因境有。前境若無心亦無。罪福如幻起亦滅",
   "attrib": "《宗鏡錄》引第三毘舍浮佛偈",
   "cbeta": "T2016",
   "line": 914
  },
  {
   "text": "純想即飛，必生天上",
   "attrib": "《大佛頂首楞嚴經》",
   "cbeta": "T0945",
   "line": 843
  },
  {
   "text": "六根更無他物",
   "attrib": "《大佛頂首楞嚴經》",
   "cbeta": "T0945",
   "line": 380
  },
  {
   "text": "大修行底人還落因果",
   "attrib": "《無門關》",
   "cbeta": "T2005",
   "line": 940
  },
  {
   "text": "不昧因果",
   "attrib": "《無門關》",
   "cbeta": "T2005",
   "line": 940
  },
  {
   "text": "上士一決一切了",
   "attrib": "《永嘉證道歌》",
   "cbeta": "T2014",
   "line": 363
  },
  {
   "text": "中下多聞多不信",
   "attrib": "《永嘉證道歌》",
   "cbeta": "T2014",
   "line": 363
  },
  {
   "text": "去聖遠兮邪見深",
   "attrib": "《永嘉證道歌》",
   "cbeta": "T2014",
   "line": 118
  },
  {
   "text": "在欲行禪知見力",
   "attrib": "《永嘉證道歌》",
   "cbeta": "T2014",
   "line": 672
  },
  {
   "text": "火中生蓮終不壞",
   "attrib": "《永嘉證道歌》",
   "cbeta": "T2014",
   "line": 672
  },
  {
   "text": "勇施犯重悟無生",
   "attrib": "《永嘉證道歌》",
   "cbeta": "T2014",
   "line": 625
  },
  {
   "text": "早時成佛于今在",
   "attrib": "《永嘉證道歌》",
   "cbeta": "T2014",
   "line": 625
  },
  {
   "text": "知一切法無我，得成於忍",
   "attrib": "《金剛般若波羅蜜經》",
   "cbeta": "T0235",
   "line": 479
  },
  {
   "text": "應無所住而生其心",
   "attrib": "《金剛般若波羅蜜經》",
   "cbeta": "T0235",
   "line": 133
  },
  {
   "text": "照見五蘊皆空，度一切苦厄",
   "attrib": "《般若波羅蜜多心經》",
   "cbeta": "T0251",
   "line": 264
  },
  {
   "text": "色如彼聚沫",
   "attrib": "《佛說水沫所漂經》",
   "cbeta": "T0106",
   "line": 266
  },
  {
   "text": "痛如彼水泡",
   "attrib": "《佛說水沫所漂經》",
   "cbeta": "T0106",
   "line": 266
  },
  {
   "text": "若有國土眾生應以佛身得度者，觀世音菩薩即現佛身而為說法",
   "attrib": "《妙法蓮華經》",
   "cbeta": "T0262",
   "line": 252
  },
  {
   "text": "若諸眾生本來成佛",
   "attrib": "《大方廣圓覺修多羅了義經》",
   "cbeta": "T0842",
   "line": 106
  }
 ],
