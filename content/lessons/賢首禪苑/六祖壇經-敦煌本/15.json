{
 "proof": [
  {
   "text": "一行三昧者，於一切時中，行、住、坐、臥，常行直心是",
   "attrib": "《六祖壇經》敦煌本",
   "cbeta": "T2007",
   "line": 843
  },
  {
   "text": "善知識心中眾生，各於自身自性自度",
   "attrib": "《六祖壇經》敦煌本",
   "cbeta": "T2007",
   "line": 809
  },
  {
   "text": "不見他人過罪",
   "attrib": "《六祖壇經》敦煌本",
   "cbeta": "T2007",
   "line": 286
  },
  {
   "text": "一燈能除千年闇，一智能滅萬年愚",
   "attrib": "《六祖壇經》敦煌本",
   "cbeta": "T2007",
   "line": 202
  },
  {
   "text": "依一心法，有二種門",
   "attrib": "《大乘起信論》",
   "cbeta": "T1666",
   "line": 294
  },
  {
   "text": "一者、心真如門",
   "attrib": "《大乘起信論》",
   "cbeta": "T1666",
   "line": 294
  },
  {
   "text": "一者、無明業相",
   "attrib": "《大乘起信論》",
   "cbeta": "T1666",
   "line": 445
  },
  {
   "text": "二者、能見相",
   "attrib": "《大乘起信論》",
   "cbeta": "T1666",
   "line": 453
  },
  {
   "text": "三者、境界相",
   "attrib": "《大乘起信論》",
   "cbeta": "T1666",
   "line": 455
  },
  {
   "text": "依於境界，心起分別愛與不愛故",
   "attrib": "《大乘起信論》",
   "cbeta": "T1666",
   "line": 503
  },
  {
   "text": "依於智故生其苦樂",
   "attrib": "《大乘起信論》",
   "cbeta": "T1666",
   "line": 507
  },
  {
   "text": "依於妄執，分別假名言相故",
   "attrib": "《大乘起信論》",
   "cbeta": "T1666",
   "line": 550
  },
  {
   "text": "尋名取著，造種種業故",
   "attrib": "《大乘起信論》",
   "cbeta": "T1666",
   "line": 558
  },
  {
   "text": "以依業受果不自在故",
   "attrib": "《大乘起信論》",
   "cbeta": "T1666",
   "line": 574
  },
  {
   "text": "如實空，以能究竟顯實故",
   "attrib": "《大乘起信論》",
   "cbeta": "T1666",
   "line": 665
  },
  {
   "text": "如實不空，以有自體",
   "attrib": "《大乘起信論》",
   "cbeta": "T1666",
   "line": 665
  },
  {
   "text": "故使不變性而緣起染淨恒殊",
   "attrib": "大乘起信論義記（唐·法藏撰）",
   "cbeta": "T1846",
   "line": 346
  },
  {
   "text": "不捨緣而即真凡聖致一",
   "attrib": "大乘起信論義記（唐·法藏撰）",
   "cbeta": "T1846",
   "line": 349
  },
  {
   "text": "皆從此經出",
   "attrib": "金剛般若波羅蜜經",
   "cbeta": "T0235",
   "line": 925
  },
  {
   "text": "於其城中，次第乞已，還至本處",
   "attrib": "金剛般若波羅蜜經",
   "cbeta": "T0235",
   "line": 857
  },
  {
   "text": "若見諸相非相，則見如來",
   "attrib": "金剛般若波羅蜜經",
   "cbeta": "T0235",
   "line": 108
  },
  {
   "text": "如來昔在然燈佛所，於法有所得不",
   "attrib": "金剛般若波羅蜜經",
   "cbeta": "T0235",
   "line": 84
  },
  {
   "text": "如人入闇，則無所見",
   "attrib": "金剛般若波羅蜜經",
   "cbeta": "T0235",
   "line": 923
  },
  {
   "text": "如人有目，日光明照，見種種色",
   "attrib": "金剛般若波羅蜜經",
   "cbeta": "T0235",
   "line": 925
  },
  {
   "text": "不取於相，如如不動",
   "attrib": "金剛般若波羅蜜經",
   "cbeta": "T0235",
   "line": 100
  },
  {
   "text": "應無所住而生其心",
   "attrib": "金剛般若波羅蜜經",
   "cbeta": "T0235",
   "line": 70
  },
  {
   "text": "若人言『如來有所說法』，即為謗佛",
   "attrib": "金剛般若波羅蜜經",
   "cbeta": "T0235",
   "line": 84
  },
  {
   "text": "知幻即離，不作方便；離幻即覺，亦無漸次",
   "attrib": "大方廣圓覺修多羅了義經",
   "cbeta": "T0842",
   "line": 907
  },
  {
   "text": "始知眾生本來成佛",
   "attrib": "大方廣圓覺修多羅了義經",
   "cbeta": "T0842",
   "line": 322
  },
  {
   "text": "若能轉物，則同如來",
   "attrib": "首楞嚴經",
   "cbeta": "T0945",
   "line": 106
  },
  {
   "text": "端坐念實相",
   "attrib": "佛說觀普賢菩薩行法經",
   "cbeta": "T0277",
   "line": 272
  },
  {
   "text": "眾罪如霜露",
   "attrib": "佛說觀普賢菩薩行法經",
   "cbeta": "T0277",
   "line": 272
  },
  {
   "text": "慧日能消除",
   "attrib": "佛說觀普賢菩薩行法經",
   "cbeta": "T0277",
   "line": 274
  },
  {
   "text": "譬如高原陸地不生蓮華，卑濕淤泥乃生此華",
   "attrib": "維摩詰所說經",
   "cbeta": "T0475",
   "line": 186
  },
  {
   "text": "應觀法界性",
   "attrib": "大方廣佛華嚴經",
   "cbeta": "T0279",
   "line": 792
  },
  {
   "text": "一切唯心造",
   "attrib": "大方廣佛華嚴經",
   "cbeta": "T0279",
   "line": 792
  },
  {
   "text": "照見五蘊皆空，度一切苦厄",
   "attrib": "般若波羅蜜多心經",
   "cbeta": "T0251",
   "line": 847
  },
  {
   "text": "不生不滅，不垢不淨，不增不減",
   "attrib": "般若波羅蜜多心經",
   "cbeta": "T0251",
   "line": 954
  },
  {
   "text": "眾生如幻，會者亦如幻，吾我亦復如幻如夢",
   "attrib": "放光般若經",
   "cbeta": "T0221",
   "line": 909
  },
  {
   "text": "豁達空撥因果",
   "attrib": "永嘉證道歌",
   "cbeta": "T2014",
   "line": 236
  },
  {
   "text": "莽莽蕩蕩招殃禍",
   "attrib": "永嘉證道歌",
   "cbeta": "T2014",
   "line": 236
  },
  {
   "text": "棄有著空病亦然",
   "attrib": "永嘉證道歌",
   "cbeta": "T2014",
   "line": 641
  },
  {
   "text": "還如避溺而投火",
   "attrib": "永嘉證道歌",
   "cbeta": "T2014",
   "line": 641
  },
  {
   "text": "去聖遠兮邪見深",
   "attrib": "永嘉證道歌",
   "cbeta": "T2014",
   "line": 515
  },
  {
   "text": "觀惡言是功德",
   "attrib": "永嘉證道歌",
   "cbeta": "T2014",
   "line": 403
  },
  {
   "text": "不因訕謗起冤親",
   "attrib": "永嘉證道歌",
   "cbeta": "T2014",
   "line": 403
  },
  {
   "text": "何期自性，本自清淨",
   "attrib": "六祖大師法寶壇經（曹溪本）",
   "cbeta": "T2008",
   "line": 355
  },
  {
   "text": "何期自性，本無動搖",
   "attrib": "六祖大師法寶壇經（曹溪本）",
   "cbeta": "T2008",
   "line": 355
  },
  {
   "text": "前念不生即心，後念不滅即佛",
   "attrib": "六祖大師法寶壇經（曹溪本）",
   "cbeta": "T2008",
   "line": 648
  },
  {
   "text": "不思善，不思惡，正與麼時，那箇是明上座本來面目",
   "attrib": "六祖大師法寶壇經（曹溪本）",
   "cbeta": "T2008",
   "line": 556
  },
  {
   "text": "惠明言下大悟",
   "attrib": "六祖大師法寶壇經（曹溪本）",
   "cbeta": "T2008",
   "line": 556
  },
  {
   "text": "臥輪有伎倆",
   "attrib": "六祖大師法寶壇經（曹溪本）",
   "cbeta": "T2008",
   "line": 703
  },
  {
   "text": "能斷百思想",
   "attrib": "六祖大師法寶壇經（曹溪本）",
   "cbeta": "T2008",
   "line": 703
  },
  {
   "text": "菩提日日長",
   "attrib": "六祖大師法寶壇經（曹溪本）",
   "cbeta": "T2008",
   "line": 703
  },
  {
   "text": "本來無一物",
   "attrib": "六祖大師法寶壇經（曹溪本）",
   "cbeta": "T2008",
   "line": 681
  },
  {
   "text": "身是菩提樹",
   "attrib": "六祖大師法寶壇經（曹溪本）",
   "cbeta": "T2008",
   "line": 681
  },
  {
   "text": "時時勤拂拭",
   "attrib": "六祖大師法寶壇經（曹溪本）",
   "cbeta": "T2008",
   "line": 681
  },
  {
   "text": "佛法在世間",
   "attrib": "六祖大師法寶壇經（曹溪本）",
   "cbeta": "T2008",
   "line": 843
  },
  {
   "text": "離世覓菩提",
   "attrib": "六祖大師法寶壇經（曹溪本）",
   "cbeta": "T2008",
   "line": 843
  },
  {
   "text": "恰如求兔角",
   "attrib": "六祖大師法寶壇經（曹溪本）",
   "cbeta": "T2008",
   "line": 845
  }
 ],
