---
import Base from "../layouts/Base.astro";
import { url } from "../lib/data";
---
<Base title="搜尋" description="在全部學習筆記與逐字稿中搜尋經名、名相、人名，可依系列與類型篩選。">
  <div class="search-wrap">
    <h1 style="font-size:1.5rem">搜尋筆記與逐字稿</h1>
    <form class="sx-form" role="search" onsubmit="return false">
      <input id="sx-q" type="search" placeholder="輸入經名、名相、人名…" aria-label="搜尋" autocomplete="off" />
    </form>
    <div class="sx-filters" id="sx-filters" hidden></div>
    <p class="sx-hint muted">只列出含有完整詞語的頁面；用空格分開多個詞，則每個詞都要出現。點結果會跳到該處並標示出來。</p>
    <p class="sx-status muted" id="sx-status" aria-live="polite"></p>
    <ol class="sx-results" id="sx-results"></ol>
    <p><button class="btn" id="sx-more" type="button" hidden>顯示更多</button></p>
  </div>
  <script is:inline type="module" src={url("scripts/search.js")} data-pagefind={url("pagefind/pagefind.js")}></script>
</Base>
