---
import Base from "../../../layouts/Base.astro";
import { allSeries, url, lessonUrl, transcriptUrl, lessonTitle, channelLabel, multiChannel, lecturer, teacherShort, seriesUrl, sutraUrl, cbetaUrl, sutraData, type Series, type Channel, plain } from "../../../lib/data";
import { graph, breadcrumbs, abs, websiteRef, type Crumb } from "../../../lib/seo";

export function getStaticPaths() {
  return allSeries().map(({ c, s }) => ({ params: { ch: c.slug, series: s.slug }, props: { c, s } }));
}
const { c, s } = Astro.props as { c: Channel; s: Series };
const hasNotes = s.lessons.some((l) => l.has_note);
// the bare sutra name is also the title of its /sutra/ page, so name the speaker here: the series' own,
// not the channel's, as some series are talks by others (students sharing)
const speaker = lecturer(s);
const pageTitle = speaker ? `${speaker}講《${s.name}》` : `${teacherShort(s.teacher) ?? channelLabel(c)}《${s.name}》`;
const pagePath = seriesUrl(c, s);
const lessonHref = (no: string, note: boolean) => (note ? lessonUrl : transcriptUrl)(`${c.slug}/${s.slug}/${no}`);
// home_sutra reads like 《維摩詰所說經》T0475（姚秦·鳩摩羅什譯）; link the id to its sutra page when there is one
const sutraId = s.home_sutra_id && sutraData.sutras[s.home_sutra_id] ? s.home_sutra_id : null;
const [sutraBefore, sutraAfter] = sutraId && s.home_sutra?.includes(sutraId)
  ? [s.home_sutra.slice(0, s.home_sutra.indexOf(sutraId)), s.home_sutra.slice(s.home_sutra.indexOf(sutraId) + sutraId.length)]
  : [s.home_sutra, null];
// for the description: "T0475，姚秦·鳩摩羅什譯" only when home_sutra has that plain shape
const translator = sutraId ? s.home_sutra?.match(new RegExp(`${sutraId}（([^（）]+)）$`))?.[1] : null;
const firstDate = s.lessons.map((l) => l.date).filter(Boolean).sort()[0];
// lesson dates are YouTube upload dates, not when the talks were given
const since = firstDate ? `影片 ${Number(firstDate.slice(0, 4))} 年 ${Number(firstDate.slice(5, 7))} 月起上傳，` : "";
const description = `${pageTitle}${translator ? `（${sutraId}，${translator}）` : ""}，${since}共 ${s.lessons.length} 講${hasNotes ? `，每講附學習筆記與完整逐字稿，可直接跳到影片對應時間點聽${speaker ? "法師" : ""}原講` : "的逐字稿"}。`;
const crumbs: Crumb[] = [["首頁", url("/")], ...(multiChannel ? [[channelLabel(c), url(`${c.slug}/`)] as Crumb] : []), [s.name, seriesUrl(c, s)]];
---
<Base title={pageTitle} description={description}
  jsonld={graph(
    {
      "@type": "CollectionPage",
      "@id": abs(pagePath),
      url: abs(pagePath),
      name: pageTitle,
      description,
      inLanguage: "zh-Hant",
      isPartOf: websiteRef(),
      ...(translator && sutraId && { about: { "@type": "CreativeWork", name: s.home_sutra?.match(/《([^》]+)》/)?.[1] ?? s.name, identifier: sutraId, sameAs: cbetaUrl(sutraId) } }),
      mainEntity: {
        "@type": "ItemList",
        numberOfItems: s.lessons.length,
        itemListElement: s.lessons.map((l, i) => ({ "@type": "ListItem", position: i + 1, name: lessonTitle(s, l), url: abs(lessonHref(l.no, l.has_note)) })),
      },
    },
    breadcrumbs(crumbs),
  )}>
  <div class="crumbs"><a href={url("/")}>首頁</a> ›{multiChannel && <> <a href={url(`${c.slug}/`)}>{channelLabel(c)}</a> ›</>}</div>
  <h1>{s.name}</h1>
  <div class="note-meta">
    {s.teacher && <span>講師：{s.teacher}</span>}
    {s.home_sutra && <span>本經：{sutraAfter !== null ? <>{sutraBefore}<a href={sutraUrl(sutraId!)}>{sutraId}</a>{sutraAfter}</> : s.home_sutra}</span>}
    <span>{s.lessons.length} 講</span>
  </div>
  {!hasNotes && <p class="raw-note" style="margin-top:16px">此系列的筆記尚在整理中，目前只有逐字稿（未經整理的字幕辨識稿）。</p>}
  <h2 class="section-title">講次</h2>
  <ul class="lesson-list">
    {s.lessons.map((l) => {
      return (
        <li>
          <a href={lessonHref(l.no, l.has_note)}>
            <span class="no">{Number(l.no)}</span>
            <span class="t">{s.lessons.length === 1 ? l.title : `第${Number(l.no)}講`}{!l.has_note && <> <span class="pill">逐字稿</span></>}</span>
            {l.scope && <span class="scope">{plain(l.scope)}</span>}
            <span class="meta">{[l.date, l.duration].filter(Boolean).join("・")}</span>
          </a>
        </li>
      );
    })}
  </ul>
</Base>
