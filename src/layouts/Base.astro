---
import "../styles/site.css";
import { url, site } from "../lib/data";

interface Props { title: string; description?: string; wide?: boolean; type?: "website" | "article"; jsonld?: object; noSuffix?: boolean; siteName?: string; noindex?: boolean }
const { title, description = site.tagline, wide = false, type = "website", jsonld, noSuffix = false, siteName = site.title, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// noSuffix: the title already names the site (the home page)
// siteName: a longer form of the site name for the suffix, e.g. 「體佛法師講經筆記」 on a lesson
const fullTitle = noSuffix || title === site.title ? title : `${title}｜${siteName}`;
// JSON inside <script>: keep "</script>" and "<!--" from closing or confusing the element
const ld = jsonld && JSON.stringify(jsonld).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:image" content={new URL(url("og.png"), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.title}：體佛法師講經的學習筆記與逐字稿`} />
    <meta name="twitter:card" content="summary_large_image" />
    {ld && <script type="application/ld+json" set:html={ld} />}
    <link rel="sitemap" href={url("sitemap-index.xml")} />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    {/* self-hosted, written by scripts/subset_font.py at build time (absent under `npm run dev`). Text shows in
        the fallback serif (--serif) until it arrives. A first visit fetches it after the page has loaded, so it does not
        hold up the page itself; once it is in the browser's cache it is applied at once. */}
    <script is:inline define:vars={{ fontCss: url("fonts/noto-serif-tc.css") }}>
      const addFont = () => {
        const l = document.createElement("link");
        l.rel = "stylesheet"; l.href = fontCss;
        document.head.appendChild(l);
      };
      let cached = false;
      try { cached = localStorage.getItem("font-cached") === fontCss; } catch (e) {}
      if (cached) addFont();
      else addEventListener("load", () => {
        addFont();
        // the font comes in slices fetched only for text on the page; once one has arrived, the stylesheet
        // is in the cache and later pages add it at once (forcing a slice here would fetch one the page may not use)
        document.fonts?.addEventListener("loadingdone", (e) => {
          if (e.fontfaces.some((f) => f.family.includes("Noto Serif TC")))
            try { localStorage.setItem("font-cached", fontCss); } catch (err) {}
        });
      });
    </script>
    <noscript><link href={url("fonts/noto-serif-tc.css")} rel="stylesheet" /></noscript>
    <script is:inline>
      try {
        const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t;
        const f = Number(localStorage.getItem("font-scale")); if (f) document.documentElement.style.fontSize = Math.round(f * 100) + "%";
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">跳到主要內容</a>
    <header class="site-head">
      <div class="site-head-inner">
        <a class="brand" href={url("/")}>{site.title}</a>
        {/* phones: 搜尋 stays in the bar, everything else folds into 選單 (menu script below) */}
        <a class="head-search" href={url("search/")}>搜尋</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          <span class="menu-icon" aria-hidden="true"></span>選單
        </button>
        <nav id="site-nav" aria-label="主選單">
          <a href={url("/")}>系列</a>
          <a href={url("e/")}>名相</a>
          <a href={url("sutra/")}>經論</a>
          <a class="nav-search" href={url("search/")}>搜尋</a>
          <a href={url("board/")}>白板</a>
          <a href={url("guide/")}>說明</a>
          <a href={url("about/")}>關於</a>
          <span class="nav-settings">
          <span class="nav-label" aria-hidden="true">字體</span>
          <span class="font-size" role="group" aria-label="字體大小">
            <button type="button" data-font="-1" aria-label="縮小字體" title="縮小字體">A<small>−</small></button>
            <button type="button" data-font="1" aria-label="放大字體" title="放大字體">A<small>+</small></button>
          </span>
          <button class="theme-toggle" type="button" aria-label="切換深淺色" title="切換深淺色">◐<span class="nav-label" aria-hidden="true">深淺</span></button>
          </span>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1" class:list={["page", { wide }]}>
      <slot />
    </main>
    <footer class="site-foot">
      <p>內容整理自法師公開講經影片。筆記為學習輔助：法義以法師原講為準，經文字句以 CBETA 為準。本站內容免費流通，請勿用於商業用途。<a href={url("about/")}>關於本站</a>・<a href={url("guide/")}>閱讀說明</a></p>
    </footer>
    <script is:inline>
      // phone menu: 選單 opens the nav as a panel; Escape, a tap outside or a link closes it
      (() => {
        const head = document.querySelector(".site-head"), btn = head.querySelector(".menu-toggle");
        const set = (open, focusBack) => {
          head.classList.toggle("menu-open", open);
          btn.setAttribute("aria-expanded", String(open));
          if (!open && focusBack) btn.focus();
        };
        btn.addEventListener("click", () => set(btn.getAttribute("aria-expanded") !== "true"));
        document.addEventListener("keydown", (e) => { if (e.key === "Escape" && head.classList.contains("menu-open")) set(false, true); });
        document.addEventListener("click", (e) => { if (head.classList.contains("menu-open") && !head.contains(e.target)) set(false); });
        head.querySelectorAll("#site-nav a").forEach((a) => a.addEventListener("click", () => set(false)));
        matchMedia("(min-width: 641px)").addEventListener("change", (m) => { if (m.matches) set(false); });
      })();
      document.querySelector(".theme-toggle").addEventListener("click", () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.theme = dark ? "light" : "dark";
        try { localStorage.setItem("theme", root.dataset.theme); } catch (e) {}
      });
      // text size for every page: steps of the root font size, remembered on this device
      (() => {
        const steps = [0.9, 1, 1.12, 1.25, 1.4, 1.6], root = document.documentElement;
        const cur = () => Math.round(parseFloat(root.style.fontSize || "100")) / 100;
        const btns = document.querySelectorAll("[data-font]");
        const sync = () => {
          const i = steps.indexOf(cur());
          btns[0].disabled = i === 0; btns[1].disabled = i === steps.length - 1;
        };
        btns.forEach((b) => b.addEventListener("click", () => {
          const i = Math.max(0, steps.indexOf(cur()));
          const f = steps[Math.min(steps.length - 1, Math.max(0, i + Number(b.dataset.font)))];
          root.style.fontSize = Math.round(f * 100) + "%";
          try { f === 1 ? localStorage.removeItem("font-scale") : localStorage.setItem("font-scale", String(f)); } catch (e) {}
          sync();
        }));
        sync();
      })();
    </script>
  </body>
</html>
